{
  "entities": {
    "Score": {
      "title": "Leaderboard Score",
      "description": "High score record for Neon Space Dodger",
      "type": "object",
      "properties": {
        "playerName": {
          "type": "string",
          "description": "Pilot callsign name",
          "minLength": 1,
          "maxLength": 30
        },
        "score": {
          "type": "number",
          "description": "Final score achieved"
        },
        "level": {
          "type": "number",
          "description": "Highest level survived"
        },
        "shardsCollected": {
          "type": "number",
          "description": "Total energy shards collected"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        }
      },
      "required": ["playerName", "score", "level", "createdAt"]
    }
  },
  "firestore": {
    "/scores/{scoreId}": {
      "schema": "Score",
      "description": "Collection of leaderboard scores"
    }
  }
}
